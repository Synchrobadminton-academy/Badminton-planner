# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Firebase Realtime Database URL (no trailing slash)
FIREBASE_URL=https://your-db.firebasedatabase.app

# Optional: restrict bot to a specific group chat
ALLOWED_CHAT_ID=

# Optional: comma-separated Telegram topic IDs to listen to
ALLOWED_TOPICS=5,229
